{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForecastResponse",
  "type": "object",
  "properties": {
    "historical": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "amount": { "type": "number" }
        },
        "required": ["date", "amount"]
      }
    },
    "forecast": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "p10": { "type": "number" },
          "p50": { "type": "number" },
          "p90": { "type": "number" }
        },
        "required": ["date", "p10", "p50", "p90"]
      }
    },
    "roast": {
      "type": "string"
    }
  },
  "required": ["historical", "forecast", "roast"]
}
